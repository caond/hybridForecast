# Complete example of using abm.acor from evoper package
# Install and load required packages
if(!require(evoper)) {
install.packages("evoper")
library(evoper)
}
# Example 1: Optimizing a simple mathematical function (Sphere function)
# This is a minimization problem where the optimal solution is at (0,0,...,0)
# Define the objective function (Sphere function: sum of squares)
sphere_function <- function(x) {
return(sum(x^2))
}
# Create ObjectiveFunction instance
# The evoper package uses specific classes for objective functions
objective <- ObjectiveFunction$new(
FUN = sphere_function,
n_objectives = 1,
n_params = 2,  # 2-dimensional problem
name = "Sphere Function"
)
# Set parameter bounds (search space)
# Lower bounds
lower_bounds <- c(-5, -5)
# Upper bounds
upper_bounds <- c(5, 5)
# Create ACOr options
# These are the algorithm parameters for Ant Colony Optimization
acor_options <- list(
maxiter = 100,        # Maximum number of iterations
k = 10,               # Archive size (number of ants)
q = 0.1,              # Locality of search (0 < q <= 1)
xi = 0.85             # Speed of convergence (0 < xi < 1)
)
# Set up bounds in the objective function
objective$lower <- lower_bounds
objective$upper <- upper_bounds
# Run ACOr optimization
cat("Running ACOr optimization...\n")
result <- abm.acor(
objective = objective,
options = acor_options
)
# Display results
cat("Optimization completed!\n")
cat("Best solution found:", result$best_params, "\n")
cat("Best fitness value:", result$best_fitness, "\n")
cat("Number of iterations:", result$iterations, "\n")
# ========================================
# Example 2: Optimizing Rosenbrock function
# This is a classic optimization benchmark
rosenbrock_function <- function(x) {
n <- length(x)
result <- 0
for(i in 1:(n-1)) {
result <- result + 100 * (x[i+1] - x[i]^2)^2 + (1 - x[i])^2
}
return(result)
}
# Create ObjectiveFunction for Rosenbrock
objective2 <- ObjectiveFunction$new(
FUN = rosenbrock_function,
n_objectives = 1,
n_params = 2,
name = "Rosenbrock Function"
)
# Set bounds
objective2$lower <- c(-2, -2)
objective2$upper <- c(2, 2)
# ACOr options for more complex problem
acor_options2 <- list(
maxiter = 200,
k = 20,
q = 0.05,
xi = 0.9
)
# Run optimization
cat("\nRunning ACOr on Rosenbrock function...\n")
result2 <- abm.acor(
objective = objective2,
options = acor_options2
)
cat("Rosenbrock optimization results:\n")
cat("Best solution:", result2$best_params, "\n")
cat("Best fitness:", result2$best_fitness, "\n")
cat("Target solution is (1,1) with fitness 0\n")
# ========================================
# Example 3: Custom function with constraints
# Optimizing a function with multiple local minima
multimodal_function <- function(x) {
# Ackley function - has many local minima but one global minimum at (0,0)
a <- 20
b <- 0.2
c <- 2 * pi
n <- length(x)
sum1 <- sum(x^2)
sum2 <- sum(cos(c * x))
result <- -a * exp(-b * sqrt(sum1/n)) - exp(sum2/n) + a + exp(1)
return(result)
}
# Create objective function
objective3 <- ObjectiveFunction$new(
FUN = multimodal_function,
n_objectives = 1,
n_params = 3,  # 3-dimensional problem
name = "Ackley Function"
)
objective3$lower <- c(-5, -5, -5)
objective3$upper <- c(5, 5, 5)
# ACOr options
acor_options3 <- list(
maxiter = 150,
k = 15,
q = 0.1,
xi = 0.8
)
cat("\nRunning ACOr on Ackley function...\n")
result3 <- abm.acor(objective3, acor_options3)
cat("Ackley function results:\n")
cat("Best solution:", result3$best_params, "\n")
cat("Best fitness:", result3$best_fitness, "\n")
cat("Global optimum is at (0,0,0) with fitness 0\n")
# ========================================
# Tips for using abm.acor effectively:
cat("\n=== Tips for using abm.acor ===\n")
cat("1. maxiter: Higher values for more complex problems\n")
cat("2. k (archive size): Larger values explore more but slower\n")
cat("3. q: Smaller values = more exploitation, larger = more exploration\n")
cat("4. xi: Controls convergence speed (closer to 1 = faster convergence)\n")
cat("5. Always set appropriate bounds for your search space\n")
cat("6. The algorithm minimizes the objective function\n")
