time_sec = abc_fit$time_sec,
final_iter = NA,
stringsAsFactors = FALSE
)
row <- row + 1L
# Acor run
acor_fit <- run_acor(reg, seed = sd)
results[[row]] <- data.frame(
algo = "ACOR",
problem = prob, d = reg$d, seed = sd,
f_best = acor_fit$f_best,
implied_f_min = acor_fit$f_min_best,
gap_to_opt = acor_fit$f_min_best - reg$f_min_star,
time_sec = acor_fit$time_sec,
final_iter = NA,
stringsAsFactors = FALSE
)
row <- row + 1L
}
}
}
result_df <- do.call(rbind, results)
# Add success rate (gap_to_opt < 1e-3)
result_df$success <- result_df$gap_to_opt < 1e-3
return(result_df)
}
############################
## Example: Tuned benchmark run
############################
# Remove browser() calls and run optimized benchmark
set.seed(42)
bench <- run_bench_spo(
problems = c("ackley"),
dims = c(2, 5),
seeds = 1:3,              # Reduced for testing, increase for production
T = 200,                  # Balanced iterations
N0 = 100,                 # Reasonable population size
eta = 0.01,
beta = 0.999,
adaptive_params = TRUE,   # Enable adaptive tuning
local_search = FALSE,     # Disable for speed, enable for better quality
verbose = TRUE
)
cat("\n=== SUMMARY STATISTICS ===\n")
summary_stats <- aggregate(
cbind(f_best, implied_f_min, gap_to_opt, time_sec, success) ~ algo + problem + d,
data = bench,
FUN = function(x) c(median = median(x))
)
print(summary_stats)
