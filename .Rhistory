# Correct example of using abm.acor from evoper package
# Install and load required packages
if(!require(evoper)) {
install.packages("evoper")
library(evoper)
}
# Example 1: Using PlainFunction with Rosenbrock function
# Based on the actual evoper documentation example
# Define the Rosenbrock function
f0.rosenbrock2 <- function(x) {
return(100 * (x[2] - x[1]^2)^2 + (1 - x[1])^2)
}
# Create PlainFunction object (this is the correct evoper class)
f <- PlainFunction$new(f0.rosenbrock2)
# Add parameters with their bounds using the Parameter method
f$Parameter(name="x1", min=-100, max=100)
f$Parameter(name="x2", min=-100, max=100)
# Run the optimization using extremize function
# The evoper package uses "extremize" as the main interface
cat("Running ACOr optimization on Rosenbrock function...\n")
result <- extremize("acor", f)
# Display results
cat("Optimization completed!\n")
print(result)
# ========================================
# Example 2: Direct use of abm.acor with custom options
# Create a simple sphere function
f0.sphere <- function(x) {
return(sum(x^2))
}
# Create PlainFunction object
f2 <- PlainFunction$new(f0.sphere)
# Add parameters
f2$Parameter(name="x1", min=-5, max=5)
f2$Parameter(name="x2", min=-5, max=5)
# Create custom ACOr options
# Based on the source code, we can see the available options
acor_options <- ACOrOptions$new()
acor_options$setValue("iterations", 100)
acor_options$setValue("n.ants", 20)
acor_options$setValue("k", 10)        # Archive size
acor_options$setValue("q", 0.1)       # Locality parameter
acor_options$setValue("Xi", 0.85)     # Speed of convergence
# Run ACOr directly
cat("\nRunning ACOr with custom options...\n")
result2 <- abm.acor(f2, acor_options)
print(result2)
# ========================================
# Example 3: More complex function - Ackley function
f0.ackley <- function(x) {
a <- 20
b <- 0.2
c <- 2 * pi
n <- length(x)
sum1 <- sum(x^2)
sum2 <- sum(cos(c * x))
result <- -a * exp(-b * sqrt(sum1/n)) - exp(sum2/n) + a + exp(1)
return(result)
}
# Create function object
f3 <- PlainFunction$new(f0.ackley)
# Add 3 parameters
f3$Parameter(name="x1", min=-5, max=5)
f3$Parameter(name="x2", min=-5, max=5)
f3$Parameter(name="x3", min=-5, max=5)
# Use extremize with default ACOr settings
cat("\nRunning ACOr on 3D Ackley function...\n")
result3 <- extremize("acor", f3)
print(result3)
# ========================================
# Example 4: Accessing results from Estimates object
# The results are stored in an Estimates object
# You can access various information:
if(exists("result2")) {
cat("\n=== Accessing detailed results ===\n")
# Get the best solution
best_solution <- result2$getBest()
cat("Best parameters found:\n")
print(best_solution)
# Get iteration history (if available)
# cat("Iteration history available:", !is.null(result2$getIterationBests()), "\n")
}
# ========================================
# Tips for using evoper effectively:
cat("\n=== Tips for using abm.acor ===\n")
cat("1. Use PlainFunction$new() to wrap your objective function\n")
cat("2. Add parameters with bounds using f$Parameter(name, min, max)\n")
cat("3. Use extremize('acor', f) for simple cases\n")
cat("4. Create ACOrOptions$new() for custom settings\n")
cat("5. Main parameters to tune:\n")
cat("   - iterations: number of algorithm iterations\n")
cat("   - n.ants: number of ants (solution candidates per iteration)\n")
cat("   - k: archive size (number of best solutions to keep)\n")
cat("   - q: locality parameter (smaller = more exploitation)\n")
cat("   - Xi: convergence speed (higher = faster convergence)\n")
cat("6. The algorithm minimizes the objective function\n")
cat("7. Results are returned as an Estimates object\n")
