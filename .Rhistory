Source = "Original")
synthetic <- data.frame(Sex = c("Male", "Female"),
Count = c(118, 82),
Source = "Synthetic")
# Expand counts to individual rows
expand_counts <- function(df) {
df[rep(seq_len(nrow(df)), df$Count), c("Sex","Source")]
}
df <- rbind(expand_counts(original), expand_counts(synthetic))
df$Y <- ifelse(df$Source == "Synthetic", 1, 0)
# Fit logistic regression: Y ~ Sex
